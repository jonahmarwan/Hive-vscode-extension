{
	"name": "hive-extension",
	"description": "A language extension for Hive",
	"author": "Jonah M Gionnone",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jonahmarwan/Hive-vscode-extension"
	},
	"publisher": "jonahmarwan",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:plaintext"
	],
	"main": "./client/out/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"contributes": {
		"languages": [{
			"id": "Hive",
			"aliases": ["Hive"],
			"extensions": [".hive", ".hv"]
		}],
		"activationEvents": [
			"onLanguage:Hive"
		],
		"grammars": [
			{
				"language": "Hive",
				"scopeName": "source.hv",
				"path": "Hive.tmLanguage.json"
			}
		]
	}
	
}