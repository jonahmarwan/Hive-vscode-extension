{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "HV Language",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.hv",
				"match": "\\b(def|as|mut)\\b"
			},
			{
				"name": "entity.name.function.hv",
				"match": "\\b(int|bool)\\b"
			},
			{
				"name": "entity.name.type.hv",
				"match": "\\b(true|false)\\b"
			},
			{
				"name": "keyword.operator.arithmetic.hv",
				"match": "(\\+|-|\\*|/|\\=)"
			}
		]
		},
		"variables": {
			"patterns": [{
				"match": "\\bdef\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
				"captures": {
					"1": {
						"name": "variable.other.definition.hv"
					}
				}
			}]
		},
		"strings": {
			"name": "string.quoted.double.hv",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.hv",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"patterns": [{
				"name": "constant.numeric.hv",
				"match": "\\b\\d+\\b"
			}]
		}
	},
	"scopeName": "source.hv"
}
